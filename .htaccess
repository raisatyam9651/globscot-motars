# Globe Scott Motors - Apache URL Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route extensionless blog post URLs: /blog/<slug>/ -> /blog/<slug>.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([^/]+)/?$ /blog/$1.php [L,PT]

    # 301 redirects for corrected (previously misspelled) slugs
    RewriteRule ^benifits-of-using-dc-motors/?$ /benefits-of-using-dc-motors/ [R=301,L]
    RewriteRule ^products-pmdc-transaxel/?$ /products-pmdc-transaxle/ [R=301,L]

    # Redirect physical .php files to extensionless URL with trailing slash
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php\ HTTP
    RewriteRule ^([^.]+)\.php$ /$1/ [R=301,L]

    # Add trailing slash if not a file and doesn't have a trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !\.[^/.]+$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # Internally route single-segment directory-like URLs to the .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/$ /$1.php [L,PT]
</IfModule>
