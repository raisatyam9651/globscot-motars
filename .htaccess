# Globe Scott Motors - Apache URL Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the request is for a real file or directory, serve directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Append .php extension if matching file exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]
</IfModule>
