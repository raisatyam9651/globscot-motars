# Globe Scott Motors - Apache URL Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect physical .php files to extensionless URL with trailing slash
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php\ HTTP
    RewriteRule ^([^.]+)\.php$ /$1/ [R=301,L]

    # Add trailing slash if not a file and doesn't have a trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !\.[^/.]+$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # Internally route directory-like URLs to the .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^/]+)/$ $1.php [L]
</IfModule>
